# syslume managed unit
[Unit]
Description=SysLume private Linux performance dashboard
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=/opt/syslume
ExecStart=/usr/bin/python3 -B /opt/syslume/monitor.py --config /opt/syslume/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
Nice=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/opt/syslume/data

[Install]
WantedBy=multi-user.target
